@{
    ViewData["Title"] = "Book a Service";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="booking-page">
    <div class="booking-container">
        <div class="booking-header">
            <h1>Book a Service</h1>
            <p>Fill in the details below and we'll confirm your appointment shortly.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="admin-alert admin-alert--error">@TempData["Error"]</div>
        }

        <div class="admin-card admin-form-card">
            <form asp-controller="Booking" asp-action="Create" method="post">
                <div class="admin-form-grid">
                    <div class="admin-form-group">
                        <label>Full Name *</label>
                        <input type="text" name="CustomerName" placeholder="Your full name" required />
                    </div>
                    <div class="admin-form-group">
                        <label>Phone Number *</label>
                        <input type="tel" name="CustomerPhone" placeholder="+91 XXXXX XXXXX" required />
                    </div>
                    <div class="admin-form-group">
                        <label>Email Address *</label>
                        <input type="email" name="CustomerEmail" placeholder="your@email.com" required />
                    </div>
                    <div class="admin-form-group">
                        <label>Preferred Date *</label>
                        <input type="date" name="PreferredDate" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="admin-form-group">
                        <label>Service Type *</label>
                        <select name="ServiceType" required class="admin-select">
                            <option value="">-- Select Service --</option>
                            <option value="CCTV Installation">CCTV Installation</option>
                            <option value="CCTV Maintenance">CCTV Maintenance</option>
                            <option value="CCTV Repair">CCTV Repair</option>
                            <option value="DVR/NVR Setup">DVR/NVR Setup</option>
                            <option value="Electrical Wiring">Electrical Wiring</option>
                            <option value="Network Setup">Network Setup</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label>Address *</label>
                        <input type="text" name="Address" placeholder="Installation address" required />
                    </div>
                    <div class="admin-form-group admin-form-group--full">
                        <label>Additional Notes</label>
                        <textarea name="Notes" rows="3" placeholder="Any specific requirements or details..."></textarea>
                    </div>
                </div>
                <div class="admin-form-actions">
                    <button type="submit" class="btn-admin-primary">Book Service</button>
                </div>
            </form>
        </div>
    </div>
</div>