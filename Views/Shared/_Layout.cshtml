<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WularTech</title>

    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Render page-specific styles -->
    @RenderSection("Styles", required: false) <!-- Make it optional -->
    <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet">
</head>


<body class="dark-mode">

    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13 3L4 14h7v7l9-11h-7V3z" />
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-name">Wular i Tech</span>
                    <span class="brand-tagline">SOLUTIONS</span>
                </div>
            </a>

            <div class="navbar-right">
                <ul class="nav-links">
                    <li><a href="/" class="nav-link active">Home</a></li>
                    <li><a href="/Services" class="nav-link">Services</a></li>
                    <li><a href="/Home/Pricing" class="nav-link">Pricing</a></li>
                    <li><a href="/Booking/Create" class="nav-link">Book Service</a></li>
                    <li><a href="/Booking/Track" class="nav-link">Track Booking</a></li>
                    @if (!string.IsNullOrEmpty(Context.Request.Cookies["jwt"]))
                    {
                        <li><a href="/Admin" class="nav-link">Admin</a></li>
                    }
                </ul>

                @{
                    var token = Context.Request.Cookies["jwt"];
                }

                <div class="auth-buttons">
                    @if (!string.IsNullOrEmpty(token))
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="btn-register" style="border:none; cursor:pointer;">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn-login">Login</a>
                        <a href="/Account/Register" class="btn-register">Register</a>
                    }
                </div>

                <a href="https://wa.me/918825048116?text=Hello%20WularTech,%20I%20want%20to%20book%20a%20service"
                   target="_blank" class="btn-book">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
                    </svg>
                    Book Now
                </a>

                <button id="themeToggle" class="theme-toggle">☀️ Light Mode</button>

                <!-- Hamburger — mobile only -->
                <button class="hamburger" id="hamburger" aria-label="Open menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu — sits right below navbar -->
    <div class="mobile-menu" id="mobileMenu">
        <a href="/">Home</a>
        <a href="/Services">Services</a>
        <a href="/Home/Pricing">Pricing</a>
        <a href="/Booking/Create">Book Service</a>
        <a href="/Booking/Track">Track Booking</a>
        @if (!string.IsNullOrEmpty(Context.Request.Cookies["jwt"]))
        {
            <a href="/Admin">Admin</a>
        }
        <div class="mobile-auth">
            @if (!string.IsNullOrEmpty(Context.Request.Cookies["jwt"]))
            {
                <form asp-controller="Account" asp-action="Logout" method="post" style="flex:1;">
                    <button type="submit" class="btn-register"
                            style="width:100%; border:none; cursor:pointer; padding:12px; border-radius:8px; font-family:inherit;">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a href="/Account/Login" class="btn-login"
                   style="flex:1; background:var(--bg-gray); text-align:center; border-radius:8px; padding:12px; display:block;">
                    Login
                </a>
                <a href="/Account/Register" class="btn-register"
                   style="flex:1; text-align:center; border-radius:8px; padding:12px; display:block;">
                    Register
                </a>
            }
        </div>
        <!-- WhatsApp in mobile menu -->
        <a href="https://wa.me/918825048116?text=Hello%20WularTech,%20I%20want%20to%20book%20a%20service"
           target="_blank"
           style="color: var(--primary-orange) !important; font-weight: 600;">
            📞 WhatsApp Us
        </a>
    </div>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer reveal">
        <div class="footer-container">

            <div class="footer-brand reveal reveal-delay-1">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M13 3L4 14h7v7l9-11h-7V3z" />
                    </svg>
                </div>
                <div class="brand-text">
                    <span class="brand-name">WularTech</span>
                    <span class="brand-tagline">SOLUTIONS</span>
                </div>
            </div>

            <div class="footer-links">
                <div class="footer-column reveal reveal-delay-1">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/#about">About Us</a></li>
                        <li><a href="/Services">Services</a></li>
                        <li><a href="/Contact">Contact</a></li>
                        <li><a href="/Home/Pricing">Pricing</a></li>
                        <li><a href="/Product/index">Products</a></li>
                        <li><a href="/Booking/Track">Track Booking</a></li>
                    </ul>
                </div>

                <div class="footer-column reveal reveal-delay-2">
                    <h4>Products</h4>
                    <ul>
                        <li><a href="/Products/Cameras">Cameras</a></li>
                        <li><a href="/Products/Wires">Electrical Wires</a></li>
                        <li><a href="/Products/Accessories">Accessories</a></li>
                    </ul>
                </div>

                <div class="footer-column reveal reveal-delay-3" style="margin-bottom:20px;">
                    <h4 style="font-size:18px; color:#1A1A2E; margin-bottom:10px;">Contact Us</h4>
                    <ul style="list-style:none; padding:0; margin:0; color:#6B7280; font-size:14px; line-height:1.8;">
                        <li>Address: Bemina, Srinagar, Near Court, 190001</li>
                        <li>Email:
                            <a href="mailto:hyatt.wular@gmail.com" style="color:#E07B39; text-decoration:none;">
                                hyatt.wular@gmail.com
                            </a>
                        </li>
                        <li>WhatsApp:
                            <a href="https://wa.me/918825048116" target="_blank"
                               style="color:#E07B39; text-decoration:none;">
                                +91 88250 48116
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-service-area">
                <h4 class="footer-area-title">Serving Across Kashmir</h4>
                <div class="footer-locations">
                    <span>📍 Srinagar</span>
                    <span>📍 Baramulla</span>
                    <span>📍 Sopore</span>
                    <span>📍 Bandipora</span>
                    <span>📍 Kupwara</span>
                    <span>📍 Ganderbal</span>
                    <span>📍 Budgam</span>
                    <span>📍 Pulwama</span>
                    <span>📍 Shopian</span>
                    <span>📍 Kulgam</span>
                    <span>📍 Anantnag</span>
                </div>
            </div>

            <div class="footer-bottom reveal reveal-delay-3">
                <p>&copy; 2026 WularTech Solutions. All rights reserved.</p>
            </div>

        </div>
    </footer>

    <script>
        // Theme toggle — starts as dark since body has dark-mode class
        const toggleBtn = document.getElementById("themeToggle");
        toggleBtn.addEventListener("click", () => {
            document.body.classList.toggle("dark-mode");
            toggleBtn.textContent = document.body.classList.contains("dark-mode")
                ? "☀️ Light Mode"
                : "🌙 Dark Mode";
        });

        // Hamburger menu
        const hamburger = document.getElementById("hamburger");
        const mobileMenu = document.getElementById("mobileMenu");

        hamburger.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileMenu.classList.toggle("open");
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
                mobileMenu.classList.remove("open");
            }
        });

        // Close when a link is tapped
        mobileMenu.querySelectorAll("a").forEach(link => {
            link.addEventListener("click", () => {
                mobileMenu.classList.remove("open");
            });
        });

        // Scroll reveal
        const reveals = document.querySelectorAll(".reveal");
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                }
            });
        }, { threshold: 0.1 });
        reveals.forEach(el => observer.observe(el));
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>