@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <style>
        .reveal {
            opacity: 0;
            transform: translateY(60px);
            transition: all 0.9s ease;
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
        .reveal-delay-1 { transition-delay: 0.2s; }
        .reveal-delay-2 { transition-delay: 0.4s; }
        .reveal-delay-3 { transition-delay: 0.6s; }
        .section-title::after {
            content: "";
            display: block;
            width: 60px;
            height: 3px;
            background: #E07B39;
            margin: 12px auto 0;
            border-radius: 5px;
            transform: scaleX(0);
            transition: transform 0.6s ease;
        }
        .section-title.active::after {
            transform: scaleX(1);
        }

        /* ── Service Categories ── */
        .services-section {
            padding: 80px 24px;
            background: var(--bg-light);
        }
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 20px;
            max-width: 1100px;
            margin: 0 auto;
        }
        .service-card {
            background: var(--bg-white);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 28px 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: block;
        }
        .service-card:hover {
            border-color: var(--primary-orange);
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        .service-card-icon {
            font-size: 36px;
            margin-bottom: 12px;
        }
        .service-card-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
        }
        .service-card-price {
            font-size: 12px;
            color: var(--primary-orange);
            font-weight: 600;
        }

        /* ── How It Works ── */
        .how-section {
            padding: 80px 24px;
            background: var(--bg-white);
        }
        .how-steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 32px;
            max-width: 900px;
            margin: 0 auto;
            text-align: center;
        }
        .how-step-number {
            width: 48px;
            height: 48px;
            background: var(--primary-orange);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 700;
            margin: 0 auto 16px;
        }
        .how-step-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 8px;
        }
        .how-step-desc {
            font-size: 14px;
            color: var(--text-gray);
            line-height: 1.7;
        }

        /* ── For Business Banner ── */
        .business-banner {
            background: var(--dark-navy);
            padding: 60px 24px;
            text-align: center;
        }
        .business-banner h2 {
            font-family: var(--font-serif);
            font-size: 36px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 12px;
        }
        .business-banner p {
            color: rgba(255,255,255,0.6);
            font-size: 16px;
            max-width: 520px;
            margin: 0 auto 32px;
        }
        .business-banner-btns {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Mobile fixes */
        @@media (max-width: 768px) {
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .how-steps {
                grid-template-columns: 1fr;
                gap: 24px;
            }
            .business-banner h2 {
                font-size: 26px;
            }
        }
        @@media (max-width: 480px) {
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
        }
    </style>
</head>

