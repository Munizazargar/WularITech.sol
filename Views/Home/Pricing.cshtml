<!-- Additional Services Table -->
<section style="padding: 0 0 80px; background: var(--bg-light);">
    <div class="container" style="padding-top: 60px;">
        <h2 class="section-title" style="margin-bottom: 8px;">All Service Rates</h2>
        <p class="section-subtitle">Quick reference for all our services</p>

        <div style="max-width: 800px; margin: 0 auto; background: var(--bg-white); border-radius: 16px; border: 1px solid var(--border-color); overflow: hidden; box-shadow: var(--shadow-md);">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: var(--dark-navy);">
                        <th style="padding: 16px 24px; text-align: left; color: #fff; font-size: 14px; font-weight: 600;">Service</th>
                        <th style="padding: 16px 24px; text-align: left; color: #fff; font-size: 14px; font-weight: 600;">Starting Price</th>
                        <th style="padding: 16px 24px; text-align: left; color: #fff; font-size: 14px; font-weight: 600;">Note</th>
                    </tr>
                </thead>
                <tbody>
                    @{
    var rows = new[]
    {
        new { Service = "🚿 Plumbing", Price = "₹300", Note = "Per visit" },
        new { Service = "🍳 Cook on Demand", Price = "₹800", Note = "Per day" },
        new { Service = "🧹 House Help", Price = "₹400", Note = "Per day" },
        new { Service = "📷 CCTV Installation", Price = "₹1,500", Note = "Per camera" },
        new { Service = "🔧 CCTV Repair", Price = "₹500", Note = "Diagnosis free" },
        new { Service = "🖥️ DVR/NVR Setup", Price = "₹800", Note = "Per device" },
        new { Service = "🔍 CCTV Maintenance", Price = "₹300", Note = "Per visit" },
        new { Service = "⚡ Electrical Wiring", Price = "₹500", Note = "Per point" },
        new { Service = "🌐 Network Setup", Price = "₹1,000", Note = "Per location" },
        new { Service = "🏠 Home Security Package", Price = "₹8,999", Note = "4 cameras + DVR" },
    };
    bool isAlt = false;
}
                    }
                    @foreach (var row in rows)
                    {
                        <tr style="background: @(isAlt ? "var(--bg-light)" : "var(--bg-white)");">
                            <td style="padding: 14px 24px; color: var(--text-dark); font-size: 14px; font-weight: 500; border-bottom: 1px solid var(--border-color);">@row.Service</td>
                            <td style="padding: 14px 24px; color: var(--primary-orange); font-size: 15px; font-weight: 700; border-bottom: 1px solid var(--border-color);">@row.Price</td>
                            <td style="padding: 14px 24px; color: var(--text-gray); font-size: 13px; border-bottom: 1px solid var(--border-color);">@row.Note</td>
                        </tr>
                        isAlt = !isAlt;
                    }
                </tbody>
            </table>
        </div>

        <p style="text-align: center; color: var(--text-gray); font-size: 13px; margin-top: 16px;">
            * Prices may vary based on location and complexity. Contact us for a free quote.
        </p>
    </div>
</section>

