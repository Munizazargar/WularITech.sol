@{
    ViewData["Title"] = "Register";
}

<section class="auth-section">
    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-header">
                <div class="auth-icon register-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                        <circle cx="8.5" cy="7" r="4"/>
                        <line x1="20" y1="8" x2="20" y2="14"/>
                        <line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                </div>
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join WularTech and secure your world</p>
            </div>

            <!-- Registration Form -->
            <form method="post" asp-action="Register" class="auth-form">
                @Html.AntiForgeryToken()

                @if (ViewBag.errorMessage != null)
                {
                    <div class="auth-error-message">@ViewBag.errorMessage</div>
                }
                @if (ViewBag.message != null)
                {
                    <div class="auth-error-message">@ViewBag.message</div>
                }

                <!-- Username -->
                <div class="form-group">
                    <label for="username">Username</label>
                    <div class="input-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <input type="text" id="username" name="Username" placeholder="Enter your username" required />
                    </div>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                        <input type="email" id="email" name="Email" placeholder="Enter your email" required />
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <input type="password" id="password" name="Password" placeholder="Create a password" required />
                    </div>
                    <span class="input-hint">Must be at least 8 characters</span>
                </div>

                <!-- Terms Checkbox -->
                <div class="form-options">
                    <label class="checkbox-wrapper">
                        <input type="checkbox" name="AgreeTerms" required />
                        <span class="checkmark"></span>
                        I agree to the <a href="/Terms">Terms of Service</a> and <a href="/Privacy">Privacy Policy</a>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-primary">
                    Create Account
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12,5 19,12 12,19"/>
                    </svg>
                </button>
            </form>

            

            <!-- Footer -->
            <div class="auth-footer">
                <p>Already have an account? <a href="/Account/Login">Sign In</a></p>
            </div>
        </div>

        <!-- Right-side Image -->
        <div class="auth-image">
            <img src="~/images/auth-bg.jpg" alt="Security" />
            <div class="auth-image-overlay">
                <h2>Join WularTech</h2>
                <p>Get access to premium security products and expert installation services across Srinagar.</p>
            </div>
        </div>
    </div>
</section>