@model WularItech_solutions.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-section">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Forgot Password</h1>
                <p class="auth-subtitle">Enter your email and we'll send you a reset link</p>
            </div>

            <form method="post" asp-action="ForgotPassword" class="auth-form">
                @if (ViewBag.errorMessage != null)
                {
                    <div class="auth-error-message">@ViewBag.errorMessage</div>
                }
                @if (ViewBag.message != null)
                {
                    <div class="auth-success-message">@ViewBag.message</div>
                }

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-wrapper">
                        <input type="email" id="email" name="Email" placeholder="Enter your email" value="@(Model?.Email)" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth-primary">
                    Send Reset Link
                </button>
            </form>

            <div class="auth-footer">
                <p><a href="/Account/Login">Back to Login</a></p>
            </div>
        </div>

        <div class="auth-image">
            <img src="~/images/auth-bg.jpg" alt="Security" />
            <div class="auth-image-overlay">
                <h2>Secure Your World</h2>
                <p>Join thousands of customers trusting WularTech for their security and electrical needs.</p>
            </div>
        </div>
    </div>
</section>