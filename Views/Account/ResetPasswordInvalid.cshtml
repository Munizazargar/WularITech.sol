@{
    ViewData["Title"] = "Invalid Link";
}

<section class="auth-section">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Link Expired</h1>
                <p class="auth-subtitle">@ViewBag.errorMessage</p>
            </div>
            <div class="auth-footer">
                <p><a href="/Account/ForgotPassword">Request a new link</a></p>
            </div>
        </div>
    </div>
</section>