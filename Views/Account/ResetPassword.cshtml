@model WularItech_solutions.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="auth-section">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Reset Password</h1>
                <p class="auth-subtitle">Choose a new password for your account</p>
            </div>

            <form method="post" asp-action="ResetPassword" class="auth-form">
                @if (ViewBag.errorMessage != null)
                {
                    <div class="auth-error-message">@ViewBag.errorMessage</div>
                }

                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="hidden" name="Token" value="@Model.Token" />

                <div class="form-group">
                    <label for="password">New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="password" name="Password" placeholder="Enter new password" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" name="ConfirmPassword" placeholder="Confirm new password" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-auth-primary">
                    Reset Password
                </button>
            </form>
        </div>

        <div class="auth-image">
            <img src="~/images/auth-bg.jpg" alt="Security" />
            <div class="auth-image-overlay">
                <h2>Secure Your World</h2>
                <p>Join thousands of customers trusting WularTech for their security and electrical needs.</p>
            </div>
        </div>
    </div>
</section>