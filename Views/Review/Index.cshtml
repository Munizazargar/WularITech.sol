@model List<WularItech_solutions.Models.Review>
@{
    ViewData["Title"] = "Customer Reviews";
}

<section class="auth-section">
    <div class="auth-container" style="max-width: 900px;">
        <h1 class="auth-title" style="text-align:center; margin-bottom: 30px;">What Our Customers Say</h1>

        @if (!Model.Any())
        {
            <p style="text-align:center;">No reviews yet.</p>
        }
        else
        {
            <div style="display:grid; gap:20px;">
                @foreach (var review in Model)
                {
                    <div class="auth-card" style="text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <strong>@review.CustomerName</strong>
        <span>@string.Concat(Enumerable.Repeat("⭐", review.Rating))</span>
    </div>
    <p style="color:var(--text-light); font-size:13px; margin:4px 0;">@review.ServiceType</p>
    <p style="color:var(--text-dark);">@review.Comment</p>
</div>
                }
            </div>
        }
    </div>
</section>