@{
    ViewData["Title"] = "Technician Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Technician Login</title>
    <link rel="stylesheet" href="/css/site.css" />
    <style>
        body { background: #f3f4f6; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
        .login-box { background: #fff; border-radius: 16px; padding: 40px; width: 100%; max-width: 420px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
        .login-logo { color: #E07B39; font-size: 22px; font-weight: 700; margin-bottom: 8px; }
        .login-title { font-size: 20px; font-weight: 700; color: #111827; margin-bottom: 4px; }
        .login-sub { color: #6b7280; font-size: 14px; margin-bottom: 28px; }
        label { font-size: 14px; font-weight: 600; display: block; margin-bottom: 6px; color: #374151; }
        input { width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; margin-bottom: 16px; box-sizing: border-box; }
        .btn { width: 100%; padding: 12px; background: #E07B39; color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; }
        .error { background: #fee2e2; color: #991b1b; padding: 10px 14px; border-radius: 8px; font-size: 14px; margin-bottom: 16px; }
    </style>
</head>
<body>
    <div class="login-box">
        <div class="login-logo">WularTech Solutions</div>
        <div class="login-title">Technician Login</div>
        <div class="login-sub">Enter your phone and password to continue</div>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form method="post" action="/Technician/Login">
            <label>Phone Number</label>
            <input name="phone" type="tel" placeholder="e.g. 9876543210" required />
            <label>Password</label>
            <input name="password" type="password" placeholder="Default: your phone number" required />
            <button type="submit" class="btn">Login</button>
        </form>
    </div>
</body>
</html>