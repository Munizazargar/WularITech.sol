@model List<WularItech_solutions.Models.Booking>
@{
    ViewData["Title"] = "Technician Dashboard";
}

<style>
    .welcome { font-size: 22px; font-weight: 700; color: #111827; margin-bottom: 8px; }
    .sub { color: #6b7280; font-size: 14px; margin-bottom: 28px; }
    .card { background: #fff; border-radius: 12px; padding: 20px 24px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,0.07); border-left: 4px solid #E07B39; }
    .card-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; }
    .service { font-size: 17px; font-weight: 700; color: #111827; }
    .customer { color: #6b7280; font-size: 14px; margin-top: 4px; }
    .detail { color: #374151; font-size: 14px; margin-top: 6px; }
    .badge { padding: 4px 12px; border-radius: 50px; font-size: 12px; font-weight: 600; }
    .Pending { background: #fef3c7; color: #92400e; }
    .Confirmed { background: #d1fae5; color: #065f46; }
    .InProgress { background: #dbeafe; color: #1e40af; }
    .Completed { background: #ede9fe; color: #5b21b6; }
    .Cancelled { background: #fee2e2; color: #991b1b; }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
    .btn-status { padding: 7px 16px; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-inprogress { background: #dbeafe; color: #1e40af; }
    .btn-complete { background: #d1fae5; color: #065f46; }
    .empty { text-align: center; padding: 60px 20px; color: #9ca3af; }
    
</style>

<div style="padding: 32px; max-width: 1100px; margin: 0 auto;">
    <div class="welcome">Welcome, @ViewBag.TechnicianName 👋</div>
    <div class="sub">Here are your assigned jobs</div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#d1fae5;color:#065f46;padding:12px 16px;border-radius:8px;margin-bottom:16px;">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty">
            <div style="font-size:48px;">📋</div>
            <div style="font-size:18px;font-weight:600;margin-top:12px;">No jobs assigned yet</div>
            <div style="margin-top:6px;">Check back later</div>
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            <div class="card">
                <div class="card-top">
                    <div>
                        <div class="service">@b.ServiceType</div>
                        <div class="customer">👤 @b.CustomerName &nbsp;|&nbsp; 📞 @b.CustomerPhone</div>
                        <div class="detail">📍 @b.Address</div>
                        <div class="detail">📅 @b.PreferredDate.ToString("dd MMM yyyy")</div>
                        @if (!string.IsNullOrEmpty(b.Notes))
                        {
                            <div class="detail">📝 @b.Notes</div>
                        }
                    </div>
                    <span class="badge @b.Status">@b.Status</span>
                </div>

                <div class="actions">
                    @if (b.Status == "Pending" || b.Status == "Confirmed")
                    {
                        <form method="post" action="/Technician/UpdateStatus">
                            <input type="hidden" name="id" value="@b.BookingId" />
                            <input type="hidden" name="status" value="InProgress" />
                            <button type="submit" class="btn-status btn-inprogress">▶ Mark In Progress</button>
                        </form>
                    }
                    @if (b.Status != "Completed" && b.Status != "Cancelled")
                    {
                        <form method="post" action="/Technician/UpdateStatus">
                            <input type="hidden" name="id" value="@b.BookingId" />
                            <input type="hidden" name="status" value="Completed" />
                            <button type="submit" class="btn-status btn-complete">✅ Mark Completed</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>