@model WularItech_solutions.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7v7l9-11h-7V3z" /></svg>
            </div>
            <span>Admin Panel</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/Admin" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <a href="/Admin/Products" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                Products
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Bookings
            </a>
            <a href="/Admin/Contacts" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Messages
            </a>
            <a href="/Admin/Users" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Users
            </a>
            <a href="/" class="sidebar-link sidebar-link--back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                Back to Site
            </a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <h1 class="admin-page-title">Edit Product</h1>
            <a href="/Admin/Products" class="btn-admin-secondary">← Back</a>
        </div>

        <div class="admin-card admin-form-card">
            <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ProductId" />
                <div class="admin-form-grid">
                    <div class="admin-form-group">
                        <label>Product Name</label>
                        <input asp-for="ProductName" type="text" />
                        <span asp-validation-for="ProductName" class="admin-error"></span>
                    </div>
                    <div class="admin-form-group">
                        <label>Replace Image (optional)</label>
                        <input type="file" name="image" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ProductImage))
                        {
                            <img src="@Model.ProductImage" alt="Current" class="admin-current-image" />
                        }
                    </div>
                    <div class="admin-form-group admin-form-group--full">
                        <label>Description</label>
                        <textarea asp-for="ProductDescription" rows="3"></textarea>
                        <span asp-validation-for="ProductDescription" class="admin-error"></span>
                    </div>
                    <div class="admin-form-group">
                        <label>Price (₹)</label>
                        <input asp-for="ProductPrice" type="number" step="0.01" min="0" />
                        <span asp-validation-for="ProductPrice" class="admin-error"></span>
                    </div>
                    <div class="admin-form-group">
                        <label>Stock Quantity</label>
                        <input asp-for="ProductStock" type="number" min="0" />
                        <span asp-validation-for="ProductStock" class="admin-error"></span>
                    </div>
                </div>
                <div class="admin-form-actions">
                    <button type="submit" class="btn-admin-primary">Save Changes</button>
                    <a href="/Admin/Products" class="btn-admin-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</div>