@model List<WularItech_solutions.Models.Booking>

@{
    ViewData["Title"] = "Manage Bookings";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M13 3L4 14h7v7l9-11h-7V3z" />
                </svg>
            </div>
            <span>Admin Panel</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/Admin" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>
            <a href="/Admin/Products" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                </svg>
                Products
            </a>
            <a href="/Admin/Bookings" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                Bookings
            </a>
            <a href="/Admin/Contacts" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                </svg>
                Messages
            </a>
            <a href="/Admin/Users" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                </svg>
                Users
            </a>
            <a href="/" class="sidebar-link sidebar-link--back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                </svg>
                Back to Site
            </a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <h1 class="admin-page-title">Service Bookings</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["Success"]</div>
        }

        <div class="admin-card">
            @if (Model.Any())
            {
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Service</th>
                                <th>Date</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="admin-actions-row">
                                            <!-- Status Update -->
                                            <form asp-action="UpdateBookingStatus" method="post" style="display:flex; gap:4px;">
                                                <input type="hidden" name="id" value="@b.BookingId" />
                                                <select name="status" class="admin-select">
                                                    <option value="Pending" selected="@(b.Status == "Pending")">Pending</option>
                                                    <option value="Confirmed" selected="@(b.Status == "Confirmed")">Confirmed
                                                    </option>
                                                    <option value="Completed" selected="@(b.Status == "Completed")">Completed
                                                    </option>
                                                    <option value="Cancelled" selected="@(b.Status == "Cancelled")">Cancelled
                                                    </option>
                                                </select>
                                                <button type="submit" class="btn-admin-edit">Update</button>
                                            </form>

                                            <!-- Assign Technician -->
                                            <form asp-action="AssignTechnician" method="post" style="display:flex; gap:4px;">
                                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                                <select name="technicianId" class="admin-select">
                                                    <option value="">-- Assign Tech --</option>
                                                    @foreach (var tech in
                                                                                (List<WularItech_solutions.Models.Technician>)ViewBag.Technicians)
                                                    {
                                                        <option value="@tech.TechnicianId"
                                                                selected="@(b.TechnicianId == tech.TechnicianId)">
                                                            @tech.FullName (@tech.Skill)
                                                        </option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn-admin-edit">Assign</button>
                                            </form>

                                            <!-- Delete -->
                                            <form asp-action="DeleteBooking" asp-route-id="@b.BookingId" method="post"
                                                  onsubmit="return confirm('Delete this booking?');">
                                                <button type="submit" class="btn-admin-delete">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="admin-empty">No bookings yet.</p>
            }
        </div>
    </main>
</div>