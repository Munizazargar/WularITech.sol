@{
    ViewData["Title"] = "Admin Dashboard";
    var recentBookings = ViewBag.RecentBookings as List<WularItech_solutions.Models.Booking>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="admin-wrapper">

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 3L4 14h7v7l9-11h-7V3z" /></svg>
            </div>
            <span>Admin Panel</span>
        </div>
        <nav class="sidebar-nav">
            <a href="/Admin" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <a href="/Admin/Products" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                Products
            </a>
            <a href="/Admin/Bookings" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Bookings
            </a>
            <a href="/Admin/Contacts" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Messages
            </a>
            <a href="/Admin/Users" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                Users
            </a>

            <a href="/Admin/Technicians" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                Technicians
            </a>
            

            <a href="/" class="sidebar-link sidebar-link--back">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                Back to Site
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <div class="admin-topbar">
            <h1 class="admin-page-title">Dashboard Overview</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert admin-alert--success">@TempData["Success"]</div>
        }

        <!-- Stats Cards -->
        <div class="admin-stats">
            <div class="stat-card-admin">
                <div class="stat-icon stat-icon--orange">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@ViewBag.TotalProducts</span>
                    <span class="stat-label">Total Products</span>
                </div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-icon stat-icon--navy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@ViewBag.TotalBookings</span>
                    <span class="stat-label">Total Bookings</span>
                </div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-icon stat-icon--yellow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@ViewBag.PendingBookings</span>
                    <span class="stat-label">Pending Bookings</span>
                </div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-icon stat-icon--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@ViewBag.TotalUsers</span>
                    <span class="stat-label">Registered Users</span>
                </div>
            </div>
        </div>

        <!-- Recent Bookings -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h2>Recent Bookings</h2>
                <a href="/Admin/Bookings" class="btn-admin-link">View All →</a>
            </div>
            @if (recentBookings != null && recentBookings.Any())
            {
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in recentBookings)
                            {
                                <tr>
                                    <td>@b.CustomerName</td>
                                    <td>@b.ServiceType</td>
                                    <td>@b.PreferredDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="status-badge status-@b.Status.ToLower()">@b.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="admin-empty">No bookings yet.</p>
            }
        </div>
    </main>
</div>